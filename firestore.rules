rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentAssignmentPath(uid) {
      return /databases/$(database)/documents/user_assignments/$(uid + "_2026_2");
    }

    function currentAssignmentId(uid) {
      return uid + "_2026_2";
    }

    function hasCurrentHealthTeacherAssignment() {
      return signedIn()
        && exists(currentAssignmentPath(request.auth.uid))
        && get(currentAssignmentPath(request.auth.uid)).data.active == true
        && get(currentAssignmentPath(request.auth.uid)).data.keys().hasAll(["roles"])
        && get(currentAssignmentPath(request.auth.uid)).data.roles.hasAny(["health_teacher"]);
    }

    function hasCurrentHealthTeacherOrAdminAssignment() {
      return signedIn()
        && exists(currentAssignmentPath(request.auth.uid))
        && get(currentAssignmentPath(request.auth.uid)).data.active == true
        && get(currentAssignmentPath(request.auth.uid)).data.keys().hasAll(["roles"])
        && get(currentAssignmentPath(request.auth.uid)).data.roles.hasAny(["health_teacher", "admin"]);
    }

    function hasCurrentStudentCarePublicAssignment() {
      return signedIn()
        && exists(currentAssignmentPath(request.auth.uid))
        && get(currentAssignmentPath(request.auth.uid)).data.active == true
        && get(currentAssignmentPath(request.auth.uid)).data.keys().hasAll(["roles"])
        && get(currentAssignmentPath(request.auth.uid)).data.roles.hasAny(["staff", "homeroom", "health_teacher", "admin"]);
    }

    function hasCurrentHomeroomAssignment() {
      return signedIn()
        && exists(currentAssignmentPath(request.auth.uid))
        && get(currentAssignmentPath(request.auth.uid)).data.active == true
        && get(currentAssignmentPath(request.auth.uid)).data.keys().hasAll(["roles", "grade", "classNo"])
        && get(currentAssignmentPath(request.auth.uid)).data.roles.hasAny(["homeroom"]);
    }

    function isValidSelfUserCreate(uid) {
      return isSelf(uid)
        && request.resource.data.keys().hasOnly(["uid", "email", "displayName", "active", "createdAt", "updatedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.active == true;
    }

    function isValidSelfUserUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["email", "displayName", "updatedAt"])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.active == resource.data.active;
    }

    function isValidAssignmentData(data) {
      return data.keys().hasOnly([
          "uid",
          "schoolYear",
          "semester",
          "roles",
          "grade",
          "classNo",
          "position",
          "staffId",
          "active",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "uid",
          "schoolYear",
          "semester",
          "roles",
          "grade",
          "classNo",
          "position",
          "active",
          "createdAt",
          "updatedAt"
        ])
        && data.uid is string
        && data.schoolYear is number
        && data.semester is number
        && data.roles is list
        && data.roles.size() > 0
        && data.roles.hasOnly(["staff", "homeroom", "health_teacher", "admin"])
        && (
          (data.roles.hasAny(["homeroom"]) && data.grade is number && data.classNo is number)
          || (!data.roles.hasAny(["homeroom"]) && data.grade == null && data.classNo == null)
        )
        && (data.position == null || data.position is string)
        && (!data.keys().hasAny(["staffId"]) || data.staffId == null || data.staffId is string)
        && data.active is bool;
    }

    function isValidAccessRequestCreate(data) {
      return data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "schoolYear",
          "semester",
          "requestedRole",
          "status",
          "requestedAt",
          "updatedAt",
          "reviewedBy",
          "reviewedAt",
          "reviewNote",
          "applicant"
        ])
        && data.keys().hasAll([
          "uid",
          "email",
          "displayName",
          "schoolYear",
          "semester",
          "requestedRole",
          "status",
          "requestedAt",
          "updatedAt",
          "reviewedBy",
          "reviewedAt",
          "reviewNote",
          "applicant"
        ])
        && data.uid == request.auth.uid
        && data.email == request.auth.token.email
        && data.displayName is string
        && data.schoolYear == 2026
        && data.semester == 2
        && data.requestedRole == "staff"
        && data.status == "pending"
        && data.requestedAt == request.time
        && data.updatedAt == request.time
        && data.reviewedBy == null
        && data.reviewedAt == null
        && data.reviewNote == null
        && isValidAccessRequestApplicant(data.applicant);
    }

    function isValidAccessRequestApplicant(applicant) {
      return applicant.keys().hasOnly(["realName", "department", "staffType"])
        && applicant.keys().hasAll(["realName", "department", "staffType"])
        && applicant.realName is string
        && applicant.realName.size() >= 2
        && applicant.department is string
        && applicant.department.size() > 0
        && (
          (
            applicant.staffType == "교사"
            && applicant.department in [
              "교무교육과정부",
              "진로진학홍보부",
              "연구정보부",
              "창의인성부",
              "생활안전부",
              "1학년부",
              "2학년부",
              "3학년부"
            ]
          )
          || (applicant.staffType == "직원" && applicant.department == "행정실")
          || applicant.staffType == "기타"
        );
    }

    function isValidAccessRequestResubmit() {
      return isSelf(resource.data.uid)
        && resource.data.status == "rejected"
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "status",
          "requestedAt",
          "updatedAt",
          "reviewedBy",
          "reviewedAt",
          "reviewNote",
          "applicant"
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.schoolYear == resource.data.schoolYear
        && request.resource.data.semester == resource.data.semester
        && request.resource.data.requestedRole == resource.data.requestedRole
        && request.resource.data.status == "pending"
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewNote == null
        && isValidAccessRequestApplicant(request.resource.data.applicant);
    }

    function preservesOwnCurrentHealthTeacherAssignment(assignmentId, data) {
      return assignmentId != currentAssignmentId(request.auth.uid)
        || (data.active == true && data.roles.hasAny(["health_teacher"]));
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || hasCurrentHealthTeacherOrAdminAssignment();
      allow create: if isValidSelfUserCreate(uid);
      allow update: if isValidSelfUserUpdate(uid) || hasCurrentHealthTeacherAssignment();
      allow delete: if false;
    }

    match /user_assignments/{assignmentId} {
      allow read: if signedIn()
        && (
          assignmentId == currentAssignmentId(request.auth.uid)
          || hasCurrentHealthTeacherOrAdminAssignment()
        );
      allow create: if hasCurrentHealthTeacherAssignment()
        && isValidAssignmentData(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && preservesOwnCurrentHealthTeacherAssignment(assignmentId, request.resource.data);
      allow update: if hasCurrentHealthTeacherAssignment()
        && isValidAssignmentData(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.schoolYear == resource.data.schoolYear
        && request.resource.data.semester == resource.data.semester
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "roles",
          "grade",
          "classNo",
          "position",
          "staffId",
          "active",
          "updatedAt"
        ])
        && request.resource.data.updatedAt == request.time
        && preservesOwnCurrentHealthTeacherAssignment(assignmentId, request.resource.data);
      allow delete: if hasCurrentHealthTeacherAssignment()
        && assignmentId != currentAssignmentId(request.auth.uid);
    }

    match /access_requests/{requestId} {
      allow read: if hasCurrentHealthTeacherAssignment()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && requestId == currentAssignmentId(request.auth.uid)
        && isValidAccessRequestCreate(request.resource.data);
      allow update: if hasCurrentHealthTeacherAssignment() || isValidAccessRequestResubmit();
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if hasCurrentHealthTeacherAssignment();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if hasCurrentHealthTeacherAssignment();
    }

    match /checkups/{checkupId} {
      allow read: if true;
      allow create, update, delete: if hasCurrentHealthTeacherAssignment();
    }

    match /education_resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if hasCurrentHealthTeacherAssignment();
    }

    match /health_resources/{resourceId} {
      allow read: if true;
      allow write: if false;
    }

    match /submission_items/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if hasCurrentHealthTeacherAssignment();
    }

    match /staff_submission_tasks/{taskId} {
      allow read: if hasCurrentStudentCarePublicAssignment();
      allow write: if false;
    }

    match /staff_submission_status/{statusId} {
      allow read: if hasCurrentHealthTeacherOrAdminAssignment()
        || (
          hasCurrentStudentCarePublicAssignment()
          && get(currentAssignmentPath(request.auth.uid)).data.keys().hasAny(["staffId"])
          && get(currentAssignmentPath(request.auth.uid)).data.staffId is string
          && resource.data.staffId == get(currentAssignmentPath(request.auth.uid)).data.staffId
        );
      allow write: if false;
    }

    match /student_care_monthly_aggregates/{aggregateId} {
      allow read: if hasCurrentHealthTeacherOrAdminAssignment();
      allow write: if false;
    }

    match /student_care_presence_public/{presenceId} {
      allow read: if hasCurrentStudentCarePublicAssignment();
      allow write: if false;
    }

    match /student_care_presence_homeroom/{presenceId} {
      allow read: if hasCurrentHealthTeacherOrAdminAssignment()
        || (
          hasCurrentHomeroomAssignment()
          && resource.data.schoolYear == get(currentAssignmentPath(request.auth.uid)).data.schoolYear
          && resource.data.semester == get(currentAssignmentPath(request.auth.uid)).data.semester
          && resource.data.grade == get(currentAssignmentPath(request.auth.uid)).data.grade
          && resource.data.classNo == get(currentAssignmentPath(request.auth.uid)).data.classNo
        );
      allow write: if false;
    }

    match /staff_submissions/{submissionId} {
      function hasValidSubmissionFile() {
        return request.resource.data.file.keys().hasOnly([
          "driveFileId",
          "fileName",
          "mimeType",
          "driveUrl"
        ])
        && request.resource.data.file.keys().hasAll(["driveFileId", "fileName", "mimeType", "driveUrl"])
        && (request.resource.data.file.driveFileId == null || request.resource.data.file.driveFileId is string)
        && request.resource.data.file.fileName is string
        && request.resource.data.file.mimeType in ["application/pdf", "image/jpeg", "image/png"]
        && (request.resource.data.file.driveUrl == null || request.resource.data.file.driveUrl is string);
      }

      function isValidCprSubmission() {
        return request.resource.data.itemId == "cpr"
          && request.resource.data.keys().hasOnly([
            "itemId",
            "submitter",
            "trainingDate",
            "institution",
            "staffType",
            "file",
            "status",
            "submittedAt",
            "updatedAt"
          ]);
      }

      function isValidTbSubmission() {
        return request.resource.data.itemId == "tb"
          && request.resource.data.keys().hasOnly([
            "itemId",
            "submitter",
            "checkupDate",
            "documentType",
            "staffType",
            "file",
            "status",
            "submittedAt",
            "updatedAt"
          ]);
      }

      function hasValidRecruitConfirmations() {
        return request.resource.data.confirmations.keys().hasOnly([
          "submittedToAdminOffice",
          "xrayDateCheckAcknowledged"
        ])
        && request.resource.data.confirmations.keys().hasAll([
          "submittedToAdminOffice",
          "xrayDateCheckAcknowledged"
        ])
        && request.resource.data.confirmations.submittedToAdminOffice == true
        && request.resource.data.confirmations.xrayDateCheckAcknowledged == true;
      }

      function isValidRecruitSubmission() {
        return request.resource.data.itemId == "recruit"
          && request.resource.data.keys().hasOnly([
            "itemId",
            "submitter",
            "staffType",
            "requestType",
            "confirmations",
            "status",
            "submittedAt",
            "updatedAt"
          ])
          && request.resource.data.requestType == "employment_checkup_substitution"
          && request.resource.data.staffType is string
          && hasValidRecruitConfirmations();
      }

      allow read: if signedIn()
        && (
          resource.data.submitter.uid == request.auth.uid
          || hasCurrentHealthTeacherAssignment()
        );
      allow create: if signedIn()
        && (
          ((isValidCprSubmission() || isValidTbSubmission()) && hasValidSubmissionFile())
          || isValidRecruitSubmission()
        )
        && request.resource.data.status == "submitted"
        && request.resource.data.submitter.uid == request.auth.uid
        && request.resource.data.submitter.email == request.auth.token.email;
      allow update: if hasCurrentHealthTeacherAssignment()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "updatedAt"]);
      allow delete: if false;
    }

    match /student_health_submissions/{submissionId} {
      function isCurrentTermInfection(data) {
        return data.type == "infection"
          && data.schoolYear == 2026
          && data.semester == 2;
      }

      function hasValidStudent(data) {
        return data.student.keys().hasOnly(["grade", "classNo", "number", "name"])
          && data.student.keys().hasAll(["grade", "classNo", "number", "name"])
          && data.student.grade is number
          && data.student.classNo is number
          && data.student.number is number
          && data.student.name is string;
      }

      function hasValidInfection(data) {
        return data.infection.keys().hasOnly([
          "diseaseName",
          "diagnosisDate",
          "exclusionStartDate",
          "exclusionEndDate"
        ])
        && data.infection.keys().hasAll(["diseaseName", "diagnosisDate", "exclusionStartDate", "exclusionEndDate"])
        && data.infection.diseaseName is string
        && (data.infection.diagnosisDate == null || data.infection.diagnosisDate is string)
        && (data.infection.exclusionStartDate == null || data.infection.exclusionStartDate is string)
        && (data.infection.exclusionEndDate == null || data.infection.exclusionEndDate is string);
      }

      function hasValidReport(data) {
        return data.report.keys().hasOnly(["status", "submissionStatus", "caseStatus", "note"])
          && data.report.keys().hasAll(["status", "note"])
          && data.report.status == "submitted"
          && (!data.report.keys().hasAny(["submissionStatus"]) || data.report.submissionStatus == "submitted")
          && (!data.report.keys().hasAny(["caseStatus"]) || data.report.caseStatus == "new")
          && (data.report.note == null || data.report.note is string);
      }

      function hasValidSubmittedBy(data) {
        return data.submittedBy.keys().hasOnly(["uid", "email", "displayName"])
          && data.submittedBy.keys().hasAll(["uid", "email", "displayName"])
          && data.submittedBy.uid == request.auth.uid
          && data.submittedBy.email == request.auth.token.email
          && data.submittedBy.displayName is string;
      }

      function isValidLegacyInfectionStatus(status) {
        return status in ["submitted", "reviewing", "completed"];
      }

      function isValidInfectionSubmissionStatus(status) {
        return status in ["submitted", "reviewed"];
      }

      function isValidInfectionCaseStatus(status) {
        return status in ["new", "checking", "managing", "return_check_needed", "closed"];
      }

      function hasValidManagedReport(data) {
        return data.report.keys().hasOnly([
          "status",
          "submissionStatus",
          "caseStatus",
          "note",
          "reviewedAt",
          "reviewedBy",
          "caseUpdatedAt",
          "caseUpdatedBy"
        ])
        && data.report.keys().hasAll(["status", "note"])
        && isValidLegacyInfectionStatus(data.report.status)
        && (!data.report.keys().hasAny(["submissionStatus"]) || isValidInfectionSubmissionStatus(data.report.submissionStatus))
        && (!data.report.keys().hasAny(["caseStatus"]) || isValidInfectionCaseStatus(data.report.caseStatus))
        && (!data.report.keys().hasAny(["reviewedAt"]) || data.report.reviewedAt is timestamp)
        && (!data.report.keys().hasAny(["reviewedBy"]) || data.report.reviewedBy is string)
        && (!data.report.keys().hasAny(["caseUpdatedAt"]) || data.report.caseUpdatedAt is timestamp)
        && (!data.report.keys().hasAny(["caseUpdatedBy"]) || data.report.caseUpdatedBy is string)
        && (data.report.note == null || data.report.note is string);
      }

      function hasCompatibleManagedReportStatus(data) {
        return !data.report.keys().hasAny(["caseStatus"])
          || (
            data.report.caseStatus == "new"
            && data.report.status == "submitted"
          )
          || (
            data.report.caseStatus in ["checking", "managing", "return_check_needed"]
            && data.report.status == "reviewing"
            && data.report.submissionStatus == "reviewed"
          )
          || (
            data.report.caseStatus == "closed"
            && data.report.status == "completed"
            && data.report.submissionStatus == "reviewed"
          );
      }

      function isValidInfectionSubmission(data) {
        return data.keys().hasOnly([
          "type",
          "schoolYear",
          "semester",
          "student",
          "infection",
          "report",
          "submittedBy",
          "submittedAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "type",
          "schoolYear",
          "semester",
          "student",
          "infection",
          "report",
          "submittedBy",
          "submittedAt",
          "updatedAt"
        ])
        && isCurrentTermInfection(data)
        && hasValidStudent(data)
        && hasValidInfection(data)
        && hasValidReport(data)
        && hasValidSubmittedBy(data);
      }

      function matchesCurrentHomeroom(data) {
        return hasCurrentHomeroomAssignment()
          && data.schoolYear == get(currentAssignmentPath(request.auth.uid)).data.schoolYear
          && data.semester == get(currentAssignmentPath(request.auth.uid)).data.semester
          && data.student.grade == get(currentAssignmentPath(request.auth.uid)).data.grade
          && data.student.classNo == get(currentAssignmentPath(request.auth.uid)).data.classNo;
      }

      function isValidHealthTeacherInfectionUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["report", "updatedAt"])
          && request.resource.data.report.diff(resource.data.report).affectedKeys().hasOnly([
            "status",
            "submissionStatus",
            "caseStatus",
            "reviewedAt",
            "reviewedBy",
            "caseUpdatedAt",
            "caseUpdatedBy"
          ])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.type == resource.data.type
          && request.resource.data.schoolYear == resource.data.schoolYear
          && request.resource.data.semester == resource.data.semester
          && request.resource.data.student == resource.data.student
          && request.resource.data.infection == resource.data.infection
          && request.resource.data.submittedBy == resource.data.submittedBy
          && request.resource.data.submittedAt == resource.data.submittedAt
          && (!request.resource.data.report.diff(resource.data.report).affectedKeys().hasAny(["reviewedAt"])
            || request.resource.data.report.reviewedAt == request.time)
          && (!request.resource.data.report.diff(resource.data.report).affectedKeys().hasAny(["reviewedBy"])
            || request.resource.data.report.reviewedBy == request.auth.uid)
          && (!request.resource.data.report.diff(resource.data.report).affectedKeys().hasAny(["caseUpdatedAt"])
            || request.resource.data.report.caseUpdatedAt == request.time)
          && (!request.resource.data.report.diff(resource.data.report).affectedKeys().hasAny(["caseUpdatedBy"])
            || request.resource.data.report.caseUpdatedBy == request.auth.uid)
          && hasValidManagedReport(request.resource.data)
          && hasCompatibleManagedReportStatus(request.resource.data);
      }

      allow read: if hasCurrentHealthTeacherAssignment()
        || (isCurrentTermInfection(resource.data) && matchesCurrentHomeroom(resource.data));
      allow create: if isValidInfectionSubmission(request.resource.data)
        && (hasCurrentHealthTeacherAssignment() || matchesCurrentHomeroom(request.resource.data));
      allow update: if hasCurrentHealthTeacherAssignment()
        && isValidHealthTeacherInfectionUpdate();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
