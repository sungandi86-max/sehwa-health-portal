{
  "functions": {
    "api/firebase/staff-directory.js": {
      "includeFiles": "node_modules/@expo-google-fonts/noto-sans-kr/400Regular/NotoSansKR_400Regular.ttf"
    }
  },
  "crons": [
    {
      "path": "/api/cron/health-mandatory-training-sync",
      "schedule": "30 20 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://sehwa-health-portal-v2.firebaseapp.com/__/auth/:path*"
    },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
